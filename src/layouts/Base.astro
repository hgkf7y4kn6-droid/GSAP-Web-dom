---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Backdrop from "../components/Backdrop.astro";
import displayFont from "@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url";
import bodyFont from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";

const {
  title = "Riches Digital Ventures | Applied Agentic AI",
  description = "Riches Digital Ventures: applied agentic AI and custom software built by Leonard Riches, from sports analytics to healthcare agents.",
  backdropVideo = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0D14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/hero-scene.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Backdrop video={backdropVideo} />
    <div class="cursor" aria-hidden="true"></div>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <script>
      import "../scripts/motion.js";
    </script>
  </body>
</html>
